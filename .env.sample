# PostgreSQL Configuration
POSTGRES_DB=database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure123

# Container Configuration
POSTGRES_CONTAINER_NAME=postgres

# Port Configuration
POSTGRES_PORT=5432

# Data Storage Configuration
POSTGRES_DATA_PATH=/var/lib/postgresql

# Volume Configuration
POSTGRES_VOLUME_NAME=data

# Network Configuration
POSTGRES_NETWORK_NAME=network

# Migration Runner Configuration
DEFAULT_CONNECTION=Host=localhost;Port=5432;Database=database;Username=postgres;Password=secure123;Pooling=true
SCRIPTS=../migrations
